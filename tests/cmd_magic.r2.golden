>22	ubyte	x	value.bytes[2]=0x%x
>23	ubyte	x	value.bytes[3]=0x%x
>24	lefloat	x	ratio=%g
>28	ubyte	x	mode=0x%x
>29	uleshort	x	delta=0x%x
>32	ulelong	x	next=0x%x
